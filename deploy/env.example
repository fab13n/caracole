#-*-conf-*-
# Fichier d'environnement pour Docker Compose.
# Copier ce fichier vers .env à la racine du projet et adapter les valeurs.

DEBUG=true

COMPOSE_PROJECT_NAME=solalim

# Protocole public : "http" pour le dev, "https" pour la prod.
# Détermine quelle config nginx est montée (deploy/http.conf ou deploy/https.conf).
PUBLIC_PROTO=http
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
PUBLIC_HOST=localhost

# Répertoire des volumes Docker (données persistantes : BDD, media, static, logs)
VOLUMES=./volumes

# Compte super-utilisateur Django (créé par docker-compose run init)
SUPERUSER_PASSWORD=changez-moi
SUPERUSER_USERNAME=solalim
SUPERUSER_EMAIL=admin@example.com

# PostgreSQL (SUPERUSER_PASSWORD est aussi le mot de passe Postgres)
POSTGRES_DBNAME=solalim
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_TIMEOUT=30

# Envoi de mails (SMTP)
# En dev, les valeurs ci-dessous sont inoffensives : les mails ne partent pas.
# En prod, configurer un vrai serveur SMTP.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Clef secrète Django (générer une valeur aléatoire pour la prod)
DJANGO_SECRET_KEY=remplacez-par-une-chaine-aleatoire-longue

# Optionnel : clef API OpenAI pour le chatbot
# OPENAI_API_KEY=sk-...
